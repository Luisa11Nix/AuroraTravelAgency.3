@model SolicitudCotizacion
@{
    ViewData["Title"] = "Cotizar viaje";
    var manana = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<div class="container py-5" style="max-width: 820px;">
    <h1 class="fw-bold">Cotiza tu viaje</h1>
    <p class="text-secondary mb-4">Completa el formulario y calcularemos el valor estimado de tu aventura.</p>

    <form asp-controller="Cotizacion" asp-action="Crear" method="post" class="feature-box" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Tu nombre" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" type="email" class="form-control" placeholder="tucorreo@ejemplo.com" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DestinoId" class="form-label"></label>
                <select asp-for="DestinoId" asp-items="(SelectList)ViewBag.Destinos" class="form-select">
                    <option value="">Selecciona un destino...</option>
                </select>
                <span asp-validation-for="DestinoId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FechaViaje" class="form-label"></label>
                <input asp-for="FechaViaje" type="date" min="@manana" class="form-control" />
                <span asp-validation-for="FechaViaje" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="NumeroViajeros" class="form-label"></label>
                <input asp-for="NumeroViajeros" type="number" min="1" max="10" class="form-control" />
                <span asp-validation-for="NumeroViajeros" class="text-danger"></span>
                <div id="avisoGrupo" class="form-text text-success d-none">¡Grupo de 4 o más! Aplicamos 10 % de descuento.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="Noches" class="form-label"></label>
                <input asp-for="Noches" type="number" min="3" max="14" class="form-control" />
                <span asp-validation-for="Noches" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Alojamiento" class="form-label"></label>
                <select asp-for="Alojamiento" asp-items="Html.GetEnumSelectList<TipoAlojamiento>()" class="form-select"></select>
                <span asp-validation-for="Alojamiento" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IncluyeTourAuroras" class="form-check-input" />
                    <label asp-for="IncluyeTourAuroras" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="Comentarios" class="form-label"></label>
                <textarea asp-for="Comentarios" rows="3" maxlength="300" class="form-control"
                          placeholder="¿Alguna petición especial?"></textarea>
                <div class="d-flex justify-content-between">
                    <span asp-validation-for="Comentarios" class="text-danger"></span>
                    <small class="text-secondary ms-auto"><span id="contadorComentarios">0</span>/300</small>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-aurora">Calcular cotización</button>
            <a class="btn btn-outline-light" asp-controller="Home" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
